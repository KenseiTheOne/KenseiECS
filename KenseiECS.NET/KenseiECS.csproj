<Project Sdk="Microsoft.NET.Sdk">

    <!-- .NET build of the Unity package in ../KenseiECS. Lives outside the
         package folder so bin/obj never end up inside a Unity project. -->
    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <RootNamespace>KenseiECS</RootNamespace>
        <AssemblyName>KenseiECS</AssemblyName>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants Condition="'$(KenseiDebug)'=='true'">$(DefineConstants);KENSEI_DEBUG</DefineConstants>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Every public member has an XML comment (CS1591), and a badly formed one
             (CS1570) is an error: it would be silently dropped from KenseiECS.xml, so
             escape '<', '>' and '&' in /// comments. -->
        <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1591</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../KenseiECS/**/*.cs" Exclude="../KenseiECS/Editor/**;../KenseiECS/Samples~/**" />
    </ItemGroup>

</Project>
