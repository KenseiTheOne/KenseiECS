Mutant: promise-221-group-start-state
Kind: bug
Class: 2.2.1-promise
Configs: rel, dbg
Until: 2.2.1
Version-note: 2.2.2 rewrote this code (the patch is for the 2.2.0/2.2.1 SystemsRunner)
Expect: RUNNER-GROUP-START-STATE
Why: AddGroup switches a group that was switched off before its registration back on (group and slot agree): breaks the promise 2.2.1 documents, a defect where the tree's documents make it

diff --git a/KenseiECS/Systems/SystemsRunner.cs b/KenseiECS/Systems/SystemsRunner.cs
--- a/KenseiECS/Systems/SystemsRunner.cs
+++ b/KenseiECS/Systems/SystemsRunner.cs
@@ -254,14 +254,15 @@
         /// a group switched off with SetActive(false) before AddGroup is added disabled (so is an
         /// unnamed Add(runner)). Do not Run() the group separately — it already runs inside this
         /// runner.
         /// Under KENSEI_DEBUG a name already used in this runner throws.
         /// </summary>
         public SystemsRunner AddGroup(string name, SystemsRunner runner) {
             ValidateNestedArgs(name, runner);
+            runner._enabled = true;
             return AddCore(runner, name, false, true);
         }
 
         private static void ValidateNestedArgs(string name, SystemsRunner runner) {
             if (runner == null) {
                 throw new ArgumentNullException(nameof(runner));
             }
