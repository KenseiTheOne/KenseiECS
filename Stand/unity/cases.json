    {
      "id": "M1",
      "tier": "quick",
      "group": "static",
      "kind": "static-meta",
      "rule": "package-layout",
      "expect": "pass",
      "title": "Every file and folder of the package has a .meta with a unique GUID (a package from a git URL is immutable)"
    },
    {
      "id": "M2",
