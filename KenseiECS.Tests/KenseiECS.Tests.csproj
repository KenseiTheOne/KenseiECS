<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <DefineConstants Condition="'$(KenseiDebug)'=='true'">$(DefineConstants);KENSEI_DEBUG</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../KenseiECS/Core/**/*.cs" LinkBase="Core" />
        <Compile Include="../KenseiECS/Systems/**/*.cs" LinkBase="Systems" />
        <Compile Include="../KenseiECS/DevTools/**/*.cs" LinkBase="DevTools" Condition="'$(KenseiDebug)'=='true'" />
        <!-- The only editor file without UnityEditor types: messages of the Debug Mode toggle and build guard. -->
        <Compile Include="../KenseiECS/Editor/KenseiDebugDefines.cs" LinkBase="Editor" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    </ItemGroup>

</Project>
